# Large / local research dumps (keep folder structure via .gitkeep)
data/raw/bigkinds/*
!data/raw/bigkinds/.gitkeep
!data/raw/bigkinds/README.md
data/raw/ecos/*
!data/raw/ecos/.gitkeep
!data/raw/ecos/README.md
data/raw/datalab/*
!data/raw/datalab/.gitkeep
!data/raw/datalab/README.md
data/processed/regimes/*
!data/processed/regimes/.gitkeep
data/processed/reactions/*
!data/processed/reactions/.gitkeep
data/processed/corpus/*
!data/processed/corpus/.gitkeep
data/processed/panel/*
!data/processed/panel/.gitkeep

# README·스키마 설명은 데이터가 아니라 문서다. 데이터 파일만 빼고 추적한다.
!data/**/*.md

