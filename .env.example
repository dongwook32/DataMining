# API keys (copy to .env and fill in)
# 한국은행 ECOS Open API
ECOS_API_KEY=your_ecos_api_key

# NAVER API HUB (검색어 트렌드 — NCP 콘솔에서 발급)
NAVER_HUB_CLIENT_ID=your_ncp_api_key_id
NAVER_HUB_CLIENT_SECRET=your_ncp_api_key

# (선택) 위 HUB 키가 없을 때 대용. 본연구는 데이터랩만 사용한다.
# NAVER_CLIENT_ID=your_naver_client_id
# NAVER_CLIENT_SECRET=your_naver_client_secret
